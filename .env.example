# English: placeholders only; replace values locally in .env.
# All aliases require an OpenAI-compatible chat-completions endpoint.
# The default stages use GLM; configure GLM_* first.

CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY
CLAUDE_BASE_URL=https://your-openai-compatible-endpoint.invalid/v1
CLAUDE_MODEL=YOUR_CLAUDE_MODEL_ID

QWEN_API_KEY=YOUR_QWEN_API_KEY
QWEN_BASE_URL=https://your-openai-compatible-endpoint.invalid/v1
QWEN_MODEL=YOUR_QWEN_MODEL_ID

GLM_API_KEY=YOUR_GLM_API_KEY
GLM_BASE_URL=https://your-openai-compatible-endpoint.invalid/v1
GLM_MODEL=YOUR_GLM_MODEL_ID

# 中文：此文件仅含占位符，请在本地 .env 中替换。
# 所有别名均需要兼容 OpenAI Chat Completions 协议的后端。
# 默认阶段使用 GLM，请先配置 GLM_*；不要提交真实密钥或私人地址。
